{
  "firestore": { "indexes": "firestore.indexes.json" },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local"]
    }
  ],
  "emulators": {
    "functions": { "port": 5011, "host": "127.0.0.1" },
    "firestore": { "port": 8090, "host": "127.0.0.1" },
    "ui": { "enabled": true, "port": 4010, "host": "127.0.0.1" },
    "hub": { "port": 4410 },
    "logging": { "port": 4510 },
    "eventarc": { "port": 9310 },
    "tasks": { "port": 9510 }
  }
}
